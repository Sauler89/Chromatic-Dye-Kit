// Reusable appearance customization item.
//
// Right-click SCDYE.ITM in the inventory and use ITEMDIAL.2DA's Customize
// button to open SCDYE.DLG. Color changes are applied by tiny helper spells
// containing opcode 7 (Set Character Colours by Palette), matching the
// mechanism used by native-style dye items. No dye is consumed.

// WeiDU's bundled helper set does not provide ADD_SPELL_HEADER. These helper
// spells are freshly CREATEd V1 SPLs, so we can add their single empty extended
// header directly and then let the standard ADD_SPELL_EFFECT function attach
// the opcode 7 effect.
DEFINE_PATCH_FUNCTION SCD_ADD_FRESH_SPELL_HEADER
BEGIN
  READ_LONG 0x64 scd_header_off
  READ_LONG 0x6a scd_fx_off
  READ_SHORT 0x68 scd_header_count

  // CREATE ~spl~ produces a 0x72-byte V1 spell with both table offsets at
  // 0x72 and no headers/effects. Keep this helper defensive in case WeiDU ever
  // initializes the same structure slightly differently.
  PATCH_IF scd_header_off = 0 BEGIN
    SET scd_header_off = 0x72
    WRITE_LONG 0x64 scd_header_off
  END
  PATCH_IF scd_fx_off = 0 BEGIN
    SET scd_fx_off = scd_header_off
    WRITE_LONG 0x6a scd_fx_off
  END

  INSERT_BYTES (scd_header_off + (scd_header_count * 0x28)) 0x28
  SET scd_new_header = scd_header_off + (scd_header_count * 0x28)

  WRITE_BYTE  (scd_new_header + 0x00) 1  // standard spell form
  WRITE_BYTE  (scd_new_header + 0x02) 4  // ability location
  WRITE_BYTE  (scd_new_header + 0x0c) 1  // self target
  WRITE_SHORT (scd_new_header + 0x0e) 0  // range
  WRITE_SHORT (scd_new_header + 0x10) 1  // minimum level
  WRITE_SHORT (scd_new_header + 0x12) 0  // casting time
  WRITE_SHORT (scd_new_header + 0x1e) 0  // effect count (updated below)
  WRITE_SHORT (scd_new_header + 0x20) 0  // first effect index
  WRITE_SHORT (scd_new_header + 0x26) 1  // no projectile

  WRITE_SHORT 0x68 (scd_header_count + 1)
  WRITE_LONG  0x6a (scd_fx_off + 0x28)
END

// Install the custom Chromatic Dye Kit artwork.
// SCDYEICO: inventory icon (large + small cycles).
// SCDYEDSC: description-screen icon used by BG:EE/BG2:EE/EET; harmless on IWD:EE.
COPY ~Chromatic-Dye-Kit/bam/scdyeico.bam~ ~override/scdyeico.bam~
COPY ~Chromatic-Dye-Kit/bam/scdyedsc.bam~ ~override/scdyedsc.bam~

COPY_EXISTING ~SW1H01.ITM~ ~override/SCDYE.ITM~
  SAY NAME1 ~Chromatic Dye Kit~
  SAY NAME2 ~Chromatic Dye Kit~
  SAY UNIDENTIFIED_DESC ~A reusable set of pigments and applicators for altering a character's appearance. Right-click the kit in the inventory and choose Customize to recolor metal and decorative details, skin, leather and straps, armor and robe trim, or hair. The kit is never consumed.~
  SAY IDENTIFIED_DESC ~A reusable set of pigments and applicators for altering a character's appearance. Right-click the kit in the inventory and choose Customize to recolor metal and decorative details, skin, leather and straps, armor and robe trim, or hair. The kit is never consumed.~

  // Replace both visual references inherited from the sword donor.
  // 0x3a: inventory icon; 0x58: description-screen icon.
  WRITE_ASCII 0x3a ~scdyeico~ #8
  WRITE_ASCII 0x58 ~scdyedsc~ #8

  // Do not retain SW1H01's sword-shaped ground BAM. An empty ground-icon
  // resref lets the engine fall back to its standard generic dropped-item bag.
  WRITE_ASCII 0x44 ~~ #8

  // Convert the sword donor into a passive miscellaneous dialog item.
  // ITEMDIAL requires the Conversable item flag (bit 11 / 0x0800). The
  // Movable and Displayable flags are kept as well. Do not inherit any weapon
  // usability restrictions or minimum-stat requirements from SW1H01.ITM.
  WRITE_LONG  0x18 0x0000080c
  WRITE_SHORT 0x1c 0
  WRITE_LONG  0x1e 0
  WRITE_SHORT 0x24 0
  WRITE_SHORT 0x26 0
  WRITE_BYTE  0x28 0
  WRITE_BYTE  0x29 0
  WRITE_BYTE  0x2a 0
  WRITE_BYTE  0x2b 0
  WRITE_BYTE  0x2c 0
  WRITE_BYTE  0x2d 0
  WRITE_BYTE  0x2e 0
  WRITE_BYTE  0x2f 0
  WRITE_BYTE  0x30 0
  WRITE_BYTE  0x31 0
  WRITE_SHORT 0x32 0
  WRITE_LONG  0x34 1
  WRITE_SHORT 0x38 1
  WRITE_SHORT 0x68 0
  WRITE_SHORT 0x70 0
BUT_ONLY

// Build one minimal self-targeting helper spell for every native color
// gradient (0..114) and each hidden character color range:
//   0 metal/decorations, 3 skin, 4 leather, 5 armor, 6 hair.
// Resource names are SCD<range>_<color>, e.g. SCD5_63.
ACTION_FOR_EACH scd_dye_range IN 0 3 4 5 6 BEGIN
  OUTER_FOR (scd_dye_color = 0; scd_dye_color < 115; ++scd_dye_color) BEGIN
    OUTER_SPRINT scd_dye_spell ~SCD%scd_dye_range%_%scd_dye_color%~

    CREATE ~spl~ ~%scd_dye_spell%~
    COPY_EXISTING ~%scd_dye_spell%.SPL~ ~override~
      WRITE_SHORT 0x1c 4
      WRITE_LONG 0x34 1
      LPF SCD_ADD_FRESH_SPELL_HEADER END
      LPF ADD_SPELL_EFFECT
        INT_VAR
          opcode         = 7
          target         = 1
          timing         = 9
          parameter1     = scd_dye_color
          parameter2     = scd_dye_range
          resist_dispel  = 2
      END
    BUT_ONLY
  END
END

// Build one cleanup spell per Dye Kit color range. Each cleanup spell uses
// opcode 321 (Remove Effects by Resource) to remove only the permanent opcode 7
// effects previously applied by this component for that same range.
//
//   SCD0CLR = metal/decorations
//   SCD3CLR = skin
//   SCD4CLR = leather/trim
//   SCD5CLR = armor/major robe trim
//   SCD6CLR = hair
//
// These cleanup spells reveal the character's underlying/base color again and
// are also used automatically before applying a new Dye Kit color, preventing
// permanent color effects from accumulating on the character.
ACTION_FOR_EACH scd_dye_range IN 0 3 4 5 6 BEGIN
  OUTER_SPRINT scd_dye_cleanup ~SCD%scd_dye_range%CLR~

  CREATE ~spl~ ~%scd_dye_cleanup%~
  COPY_EXISTING ~%scd_dye_cleanup%.SPL~ ~override~
    WRITE_SHORT 0x1c 4
    WRITE_LONG 0x34 1
    LPF SCD_ADD_FRESH_SPELL_HEADER END
  BUT_ONLY

  OUTER_FOR (scd_dye_color = 0; scd_dye_color < 115; ++scd_dye_color) BEGIN
    OUTER_SPRINT scd_dye_spell ~SCD%scd_dye_range%_%scd_dye_color%~

    COPY_EXISTING ~%scd_dye_cleanup%.SPL~ ~override~
      LPF ADD_SPELL_EFFECT
        INT_VAR
          opcode         = 321
          target         = 1
          timing         = 1
          parameter1     = 0
          parameter2     = 0
          resist_dispel  = 2
        STR_VAR
          resource       = EVAL ~%scd_dye_spell%~
      END
    BUT_ONLY
  END
END

OUTER_SET scd_dye_customize = RESOLVE_STR_REF(~Customize~)
APPEND ~ITEMDIAL.2DA~ ~SCDYE %scd_dye_customize% SCDYE~ UNLESS ~^SCDYE[ %TAB%]~

// Compile the main dialogue, then add an explicit entry trigger to state 0.
// Pocket Wardrobe uses InParty(Myself) for the same ITEMDIAL mechanism; this
// ensures supported Enhanced Editions can select the first state when Customize starts the dialogue.
COMPILE ~Chromatic-Dye-Kit/dialogs/scdye.d~
COMPILE ~Chromatic-Dye-Kit/dialogs/scdye_start_fix.d~
COMPILE ~Chromatic-Dye-Kit/dialogs/scdye_reset_cleanup.d~

// Place one identified copy in the appropriate native store.
// BG:EE   -> Winthrop (Candlekeep Inn)
// BG2:EE  -> Ribald (Adventurer's Mart)
// EET     -> both Winthrop and Ribald
// IWD:EE  -> Pomab (Easthaven)

ACTION_IF GAME_IS ~bgee~ BEGIN
  COPY_EXISTING ~INN2616.STO~ ~override~
    LPF ADD_STORE_ITEM_EX
      INT_VAR
        charge1   = 1
        stack     = 1
        unlimited = 0
      STR_VAR
        item_name = ~SCDYE~
        position  = ~FIRST~
        flags     = ~identified~
    END
  BUT_ONLY
END

ACTION_IF GAME_IS ~bg2ee~ BEGIN
  COPY_EXISTING ~RIBALD.STO~ ~override~
    LPF ADD_STORE_ITEM_EX
      INT_VAR
        charge1   = 1
        stack     = 1
        unlimited = 0
      STR_VAR
        item_name = ~SCDYE~
        position  = ~FIRST~
        flags     = ~identified~
    END
  BUT_ONLY
END

ACTION_IF GAME_IS ~eet~ BEGIN
  COPY_EXISTING ~INN2616.STO~ ~override~
    LPF ADD_STORE_ITEM_EX
      INT_VAR
        charge1   = 1
        stack     = 1
        unlimited = 0
      STR_VAR
        item_name = ~SCDYE~
        position  = ~FIRST~
        flags     = ~identified~
    END
  BUT_ONLY

  COPY_EXISTING ~RIBALD.STO~ ~override~
    LPF ADD_STORE_ITEM_EX
      INT_VAR
        charge1   = 1
        stack     = 1
        unlimited = 0
      STR_VAR
        item_name = ~SCDYE~
        position  = ~FIRST~
        flags     = ~identified~
    END
  BUT_ONLY
END

ACTION_IF GAME_IS ~iwdee~ BEGIN
  COPY_EXISTING ~EHPOMAB.STO~ ~override~
    LPF ADD_STORE_ITEM_EX
      INT_VAR
        charge1   = 1
        stack     = 1
        unlimited = 0
      STR_VAR
        item_name = ~SCDYE~
        position  = ~FIRST~
        flags     = ~identified~
    END
  BUT_ONLY
END
